# Local development uses the local URL below. On Vercel use Supabase's
# transaction-mode pooler URL (port 6543) for runtime traffic.
DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism

# On Vercel, use the Supabase direct URL or session-mode pooler (port 5432)
# for schema migrations. It is used only by `payload migrate`.
# MIGRATION_DATABASE_URL=postgres://postgres.project-ref:password@aws-region.pooler.supabase.com:5432/postgres

PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public origin of the site, used for canonical/og URLs (e.g. https://hosomo.example.vn).
# Falls back to request headers in local development when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public author accounts use Supabase Auth. Use the Project URL and the
# publishable key from Supabase > Project Settings > API. Never expose the
# service_role key to the browser or commit it to this repository.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Cloudflare Turnstile site key. Its secret is configured in the Supabase
# dashboard and is never stored in this app.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Storage S3 credentials. Create a private `media` bucket and enable
# its S3 connection in Storage settings. These credentials are server-only.
# S3_BUCKET=media
# S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
# S3_REGION=your-project-region
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Set to "true" to serve the labelled demo content in production (adds noindex).
# Demo content is always served outside production when the database is empty.
# ENABLE_DEMO_CONTENT=false

# Integration/e2e tests use this database instead of DATABASE_URL.
# TEST_DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism_test

# Transactional email (password recovery, verification). Required in
# production; in development, mail goes to an Ethereal test inbox logged at boot.
# Resend SMTP works for Payload staff mail. Public author mail is configured
# separately in Supabase Auth > SMTP Settings using the same Resend account.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=Hồ Sơ Mở <no-reply@your-domain.example>
