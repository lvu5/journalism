DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Integration/e2e tests use this database instead of DATABASE_URL.
# TEST_DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism_test

# Transactional email (password recovery, verification). Without SMTP_HOST,
# emails are logged to the server console instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
