DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public origin of the site, used for canonical/og URLs (e.g. https://hosomo.example.vn).
# Falls back to request headers in local development when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to serve the labelled demo content in production (adds noindex).
# Demo content is always served outside production when the database is empty.
# ENABLE_DEMO_CONTENT=false

# Integration/e2e tests use this database instead of DATABASE_URL.
# TEST_DATABASE_URL=postgres://journalism:journalism@127.0.0.1:5432/journalism_test

# Transactional email (password recovery, verification). Required in
# production; in development, mail goes to an Ethereal test inbox logged at boot.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
